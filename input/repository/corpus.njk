---
layout: base.njk
pagination:
  data: collections.corporaPages
  size: 1
  alias: corpus
permalink: "repository/{{ corpus.fileSlug | lower }}/index.{{ corpus.data.language }}.html"
---

{% if corpus.data.language == "de" %}
  {% set repoLink = "/repository.de.html" %}
{% else %}
  {% set repoLink = "/repository.en.html" %}
{% endif %}

<nav class="breadcrumbs">
  <a href="/">Home</a> &gt; 
  <a href="{{ repoLink }}">Repository</a> &gt; 
  <span>{{ corpus.title }}</span>
</nav>

<h1>{{ corpus.data.corpus_admin_name }}</h1>
<p class="corpus-description">{{ corpus.data.description }}</p>

<!-- ✅ Basic Metadata Display -->
<div class="corpus-meta-card">
  <table class="corpus-details">
    <tr>
      <th>Korpustitel</th>
      <td>{{ corpus.data.corpus_admin_name }}</td>
    </tr>
    <tr>
      <th>Korpus-ID</th>
      <td>{{ corpus.data.corpus_subcorpus_signet }}</td>
    </tr>
    <tr>
      <th>Anzahl L1</th>
      <td>{{ corpus.data.corpus_design_l1Type }}</td>
    </tr>
    <tr>
      <th>Kompetenzniveau</th>
      <td>
        {{ corpus.data.corpus_proficiency_levelMin }}
        -
        {{ corpus.data.corpus_proficiency_levelMax }}
      </td>
    </tr>
    <tr>
      <th>Anzahl Texte</th>
      <td>{{ corpus.data.corpus_subcorpus_sizeTexts }}</td>
    </tr>
    <tr>
      <th>Modalität</th>
      <td>{{ corpus.data.modality }}</td>
    </tr>
    <tr>
      <th>Projekt</th>
      <td>
        {% if corpus.data.corpus_admin_URLdownload %}
          <a href="{{ corpus.data.corpus_admin_URLdownload }}" target="_blank">
            Link zum Projekt
          </a>
        {% else %}
          notAvailable
        {% endif %}
      </td>
    </tr>
  </table>
</div>

<!-- Hierarchical Metadata Grouping with Dropdowns -->
{% set groups = {
  "Administrative": "corpus_admin_",
  "Design": "corpus_design_",
  "Proficiency": "corpus_proficiency_",
  "Project": "corpus_project_",
  "Subcorpus": "corpus_subcorpus_",
  "Production Setting": "productionSetting_"
} %}

<hr class="metadata-separator">

<h2>Corpus Metadata</h2>

{% for group, prefix in groups %}
  <details>
    <summary>
      <h2 class="metadata-heading">{{ group }}</h2>
    </summary>

    <table class="metadata-table">
      <tbody>
        {% for key, value in corpus.data %}
          {% if key.startsWith(prefix) %}
            <tr>
              <td class="meta-key">
                {{ displaynames[key] or (key | replace(prefix, "") | replace("_", " ")) }}
              </td>

              <td class="meta-value">
                {% if value is string %}
                  {{ value }}
                {% else %}
                  {{ value | dump }}
                {% endif %}
              </td>
            </tr>
          {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </details>
{% endfor %}

<hr class="metadata-separator">

<div class="corpus-downloads">
  <h2>Downloads</h2>
  {% set corpusFolder = corpus.data.corpus_name %}
<ul>
  {% if corpus.data.cas_data %}
    <li><a class="button" href="/data/{{ corpusFolder }}/{{ corpus.data.cas_data }}" download>CAS-data</a></li>
  {% endif %}
  {% if corpus.data.plain_text %}
    <li><a class="button" href="/data/{{ corpusFolder }}/{{ corpus.data.plain_text }}" download>Plain Text</a></li>
  {% endif %}
  {% if corpus.data.metadata_csv %}
    <li><a class="button" href="/data/{{ corpusFolder }}/{{ corpus.data.metadata_csv }}" download>Metadata (CSV)</a></li>
  {% endif %}
  {% if corpus.data.source_format %}
    <li><a class="button" href="/data/{{ corpusFolder }}/{{ corpus.data.source_format }}" download>Source Format</a></li>
  {% endif %}
</ul>
</div>

<hr class="metadata-separator">

<p>
  <a href="{{ repoLink }}" class="back-link">← Back to Repository</a>
</p>

<script>
  document.querySelectorAll('.copy-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = btn.dataset.copy;
      navigator.clipboard.writeText(text).then(() => {
        btn.textContent = "✅";
        setTimeout(() => btn.textContent = "📋", 1500);
      });
    });
  });
</script>
